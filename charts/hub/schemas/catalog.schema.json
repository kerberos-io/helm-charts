{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hub shared choice catalog v1",
  "description": "Compatible with the existing classification JSON format. Keys must be unique; no references to other catalogs.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["key", "label"],
    "properties": {
      "key": {"type": "string", "minLength": 1},
      "label": {"type": "string", "minLength": 1},
      "icon": {"type": "string", "minLength": 1}
    }
  }
}
