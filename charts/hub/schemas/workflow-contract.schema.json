{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hub workflow condition contract v1 (preparatory)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "contractVersion", "fields"],
  "properties": {
    "schemaVersion": {"const": 1},
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stage type, not a node instance. start describes initial context."
    },
    "contractVersion": {"type": "integer", "minimum": 1},
    "fields": {
      "type": "array",
      "description": "Declared condition fields. An empty array is valid for a node with no exposed condition fields.",
      "items": {"$ref": "#/definitions/field"}
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"enum": ["weeklySchedule", "conditions"]},
          "label": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "definitions": {
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Built-in authorized project-resource resolver; not a database path.",
          "oneOf": [
            {"const": "project.devices", "description": "Device keys as values, device names as labels."},
            {"const": "project.sites", "description": "Site IDs as values, site names as labels."},
            {"const": "project.groups", "description": "Group IDs as values, group names as labels."}
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^\\.\\./catalogs/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json$",
          "description": "Direct shared catalog file relative to the contract; no URLs or nested references."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "number", "boolean"]}
        }
      },
      "oneOf": [
        {"required": ["source"]},
        {"required": ["file"]},
        {"required": ["values"]}
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path", "type", "operators"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Stable identifier, unique within this contract."
        },
        "label": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.(\\*|[A-Za-z_][A-Za-z0-9_-]*))*$",
          "description": "Safe Start-context path, or relative path inside this node instance's output. Wildcards select scalar candidates."
        },
        "type": {"enum": ["string", "integer", "number", "boolean"]},
        "operators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["eq", "ne", "in", "exists", "contains", "matches", "gt", "gte", "lt", "lte"]}
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "Field may be absent even when the node completes; branch availability is determined separately."
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "choices": {"$ref": "#/definitions/choices"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "string"}}},
          "then": {
            "properties": {
              "operators": {"items": {"enum": ["eq", "ne", "in", "exists", "contains", "matches"]}},
              "choices": {"properties": {"values": {"items": {"type": "string"}}}}
            },
            "not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {
            "properties": {
              "operators": {"items": {"enum": ["eq", "ne", "in", "exists"]}},
              "choices": {"properties": {"values": {"items": {"type": "boolean"}}}}
            },
            "not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["integer", "number"]}}},
          "then": {
            "properties": {
              "operators": {"items": {"enum": ["eq", "ne", "in", "exists", "gt", "gte", "lt", "lte"]}},
              "choices": {"properties": {"values": {"items": {"type": "number"}}}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "integer"}}},
          "then": {"properties": {"choices": {"properties": {"values": {"items": {"type": "integer"}}}}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["integer", "number", "boolean"]}}},
          "then": {
            "properties": {
              "choices": {"not": {"anyOf": [{"required": ["file"]}, {"required": ["source"]}]}}
            }
          }
        }
      ]
    }
  }
}
