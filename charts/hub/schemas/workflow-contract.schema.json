{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hub workflow editor contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stage", "contractVersion", "fields"],
  "properties": {
    "schemaVersion": {"const": 1},
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stage type, not a node instance. start describes initial context."
    },
    "contractVersion": {"const": 1},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the editor shows this node. Icons and colours come from approved sets.",
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "icon": {"enum": ["play", "camera", "person", "eye-crossed", "car", "clock", "mlModel", "share"]},
        "color": {
          "enum": ["blue", "teal", "rose", "amber", "indigo", "violet", "green", "grey"],
          "description": "Theme colour token."
        }
      }
    },
    "params": {
      "type": "array",
      "maxItems": 64,
      "description": "Worker-stage settings authors enter, stored per node. An explicit list (even empty) replaces kerberoshub.workflows.editorStages params. Not supported on start.",
      "items": {"$ref": "#/definitions/param"}
    },
    "fields": {
      "type": "array",
      "description": "Typed values conditions may test. Start: the selectors device, sites, groups and classifications plus condition-only fields whose path exists in the condition root schema (models.WorkflowConditionRootSchema), e.g. device.deviceName or inputs.classify.details.*.isStatic; other inputs.<operation> paths are worker-defined. Stage: outputs relative to results.<stage>. New conditions may only use declared fields. An empty array is valid.",
      "items": {"$ref": "#/definitions/field"},
      "maxItems": 128
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"enum": ["weeklySchedule", "conditions"]},
          "label": {"type": "string", "minLength": 1}
        }
      },
      "description": "Start only. Controls offered for new authoring; omitted offers none. conditions applies to edges leaving Start.",
      "maxItems": 16
    },
    "triggerModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["automatic", "manual"]},
      "description": "Start only. Trigger modes offered for new authoring; omitted offers both."
    },
    "panel": {"$ref": "#/definitions/panel"}
  },
  "definitions": {
    "choices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Built-in authorized project-resource resolver; not a database path.",
          "oneOf": [
            {
              "const": "project.devices",
              "description": "Device keys as values, device names as labels."
            },
            {"const": "project.sites", "description": "Site IDs as values, site names as labels."},
            {
              "const": "project.groups",
              "description": "Group IDs as values, group names as labels."
            }
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^\\.\\./catalogs/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json$",
          "description": "Direct shared catalog file relative to the contract; no URLs or nested references."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "number", "boolean"]}
        }
      },
      "oneOf": [{"required": ["source"]}, {"required": ["file"]}, {"required": ["values"]}]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path", "type", "operators"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Stable identifier, unique within this contract."
        },
        "label": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.(\\*|[A-Za-z_][A-Za-z0-9_-]*))*$",
          "description": "Safe Start-context path, or relative path inside this node instance's output. Wildcards select scalar candidates."
        },
        "type": {"enum": ["string", "integer", "number", "boolean"]},
        "operators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["eq", "ne", "in", "exists", "contains", "matches", "gt", "gte", "lt", "lte"]}
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "Field may be absent even when the node completes; branch availability is determined separately."
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "choices": {"$ref": "#/definitions/choices"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "string"}}},
          "then": {
            "properties": {
              "operators": {"items": {"enum": ["eq", "ne", "in", "exists", "contains", "matches"]}},
              "choices": {"properties": {"values": {"items": {"type": "string"}}}}
            },
            "not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {
            "properties": {
              "operators": {"items": {"enum": ["eq", "ne", "in", "exists"]}},
              "choices": {"properties": {"values": {"items": {"type": "boolean"}}}}
            },
            "not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}
          }
        },
        {
          "if": {"properties": {"type": {"enum": ["integer", "number"]}}},
          "then": {
            "properties": {
              "operators": {"items": {"enum": ["eq", "ne", "in", "exists", "gt", "gte", "lt", "lte"]}},
              "choices": {"properties": {"values": {"items": {"type": "number"}}}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "integer"}}},
          "then": {"properties": {"choices": {"properties": {"values": {"items": {"type": "integer"}}}}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["integer", "number", "boolean"]}}},
          "then": {
            "properties": {"choices": {"not": {"anyOf": [{"required": ["file"]}, {"required": ["source"]}]}}}
          }
        }
      ]
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 64,
          "description": "Key in node data; unique within the contract."
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Editor section; params sharing a group appear together."
        },
        "placeholder": {"type": "string", "minLength": 1, "maxLength": 160},
        "type": {"enum": ["string", "number", "boolean", "select", "multiselect", "secret"]},
        "required": {"type": "boolean"},
        "default": {
          "description": "Value the editor pre-fills and the API stores when a node leaves the setting unset; never for secrets. Typically the worker's own default."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "optionLabels": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "minimum": {"type": "number", "description": "Inclusive lower bound for a number setting."},
        "maximum": {"type": "number", "description": "Inclusive upper bound for a number setting."},
        "choices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {"type": "string", "pattern": "^\\.\\./catalogs/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json$"}
          },
          "description": "Options for a select or multiselect setting from a shared catalog file (keys become options, labels become optionLabels). Use instead of options."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["select", "multiselect"]}}},
          "then": {"oneOf": [{"required": ["options"]}, {"required": ["choices"]}]},
          "else": {
            "not": {
              "anyOf": [{"required": ["options"]}, {"required": ["optionLabels"]}, {"required": ["choices"]}]
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "secret"}}},
          "then": {"not": {"required": ["default"]}}
        },
        {
          "if": {"properties": {"type": {"enum": ["string", "select"]}}},
          "then": {"properties": {"default": {"type": "string"}}}
        },
        {
          "if": {"properties": {"type": {"const": "multiselect"}}},
          "then": {
            "properties": {"default": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "number"}}},
          "then": {"properties": {"default": {"type": "number"}}},
          "else": {"not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}}
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}},
          "then": {"properties": {"default": {"type": "boolean"}}}
        }
      ]
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "description": "Layout of connections leaving this node. Without it, a default panel is used. A section with picker: true positions the Extra conditions catch-all; without one it is appended collapsed. On start, a panel replaces the top-level controls list.",
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/definitions/panelSection"}
        }
      }
    },
    "panelSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 80},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "collapsed": {"type": "boolean"},
        "picker": {
          "type": "boolean",
          "description": "This section is the Extra conditions catch-all over every declared field of Start and upstream stages; it holds no fields or controls."
        },
        "controls": {
          "type": "array",
          "items": {"const": "weeklySchedule"},
          "maxItems": 1,
          "description": "Start only."
        },
        "fields": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/panelField"}}
      },
      "if": {"properties": {"picker": {"const": true}}, "required": ["picker"]},
      "then": {"not": {"anyOf": [{"required": ["fields"]}, {"required": ["controls"]}]}}
    },
    "panelField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "widget"],
      "properties": {
        "field": {
          "type": "string",
          "description": "ID of a field declared in this contract; each field is placed at most once."
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "widget": {
          "enum": ["multiselect", "select", "text", "number", "toggle"],
          "description": "multiselect: string with choices (in); select: choices (eq, ne); text: string (eq, contains, matches, ne, in); number: integer or number (gte, gt, lte, lt, eq, ne); toggle: boolean (eq, ne)."
        },
        "operator": {
          "enum": ["eq", "ne", "in", "contains", "matches", "gt", "gte", "lt", "lte"],
          "description": "Fixed operator; must be declared by the field and supported by the widget. Defaults to the first widget operator the field declares."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "start"}}, "required": ["stage"]},
      "then": {"not": {"required": ["params"]}},
      "else": {"not": {"anyOf": [{"required": ["controls"]}, {"required": ["triggerModes"]}]}}
    },
    {"if": {"required": ["panel"]}, "then": {"not": {"required": ["controls"]}}}
  ]
}
