{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "classificationCatalogExistingConfigMap": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "classificationCatalog": {
      "type": ["array", "null"],
      "minItems": 1,
      "description": "Optional inline classification catalog in the Hub shared choice catalog format; replaces the bundled defaults in the chart's classification-catalog ConfigMap. Omit (or null) for the bundled defaults. Keys must be unique (checked when rendering).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "icon": {"type": "string", "minLength": 1}
        }
      }
    },
    "imageVerification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kyverno ClusterPolicy that verifies the keyless cosign signatures of UUG.AI images. Rendered only when the cluster serves kyverno.io/v1.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Create the policy when Kyverno is installed."
        },
        "validationFailureAction": {
          "type": "string",
          "enum": [
            "Audit",
            "Enforce"
          ],
          "description": "Audit reports violations; Enforce rejects pods with unsigned images."
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Ignore",
            "Fail"
          ],
          "description": "Webhook behaviour when Kyverno is unavailable."
        },
        "webhookTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "mutateDigest": {
          "type": "boolean",
          "description": "Rewrite verified tags to digests and require digests."
        },
        "registry": {
          "type": "string",
          "minLength": 1,
          "description": "Registry prefix of the verified images, e.g. ghcr.io/uug-ai."
        },
        "githubOrganization": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "subjectRegExp": {
          "type": "string",
          "minLength": 1,
          "description": "Signer certificate identity (the release workflow)."
        },
        "rekorUrl": {
          "type": "string",
          "minLength": 1
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "githubRepository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            }
          }
        }
      }
    },
    "deviceTags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Owners may assign system tags and global workflows may select devices by them. Only for deployments whose owners are trusted (self-hosted)."
            },
            "catalog": {
              "type": "array",
              "description": "The system tags owners can assign, in the Hub shared choice catalog format (key, label) plus an optional description. Keys must be unique (checked when rendering).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z0-9]([a-z0-9._:-]*[a-z0-9])?$"
                  },
                  "label": {"type": "string", "minLength": 1},
                  "description": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "kerberoshub": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "allowedOrigins": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^https?://[^/?#*@,\\s]+$"
                  },
                  "description": "Exact HTTP(S) origins for browser MCP clients, without wildcards, credentials, paths or trailing slashes. Independent of REST CORS."
                }
              }
            },
            "passkeys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "rpId": {
                  "type": "string",
                  "description": "Stable WebAuthn relying-party hostname, without scheme, port or path. Must match each frontend origin's hostname or be its parent domain."
                },
                "origins": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^https://[^/?#]+$|^http://localhost(:[0-9]+)?$"
                  },
                  "description": "Exact trusted frontend origins, with no path or trailing slash. HTTPS is required except for HTTP localhost development."
                },
                "rpName": {"type": "string"}
              },
              "if": {
                "required": ["enabled"],
                "properties": {"enabled": {"const": true}}
              },
              "then": {
                "required": ["rpId", "origins"],
                "properties": {
                  "rpId": {"minLength": 1},
                  "origins": {"minItems": 1}
                }
              }
            },
            "corsAllowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https?://[^/?#]+$"
              }
            },
            "auditExportMaxEventsPerFile": {
              "type": ["integer", "string"],
              "minimum": 1,
              "maximum": 1000000,
              "pattern": "^([1-9][0-9]{0,5}|1000000)?$",
              "description": "Most audit events one export file holds (AUDIT_EXPORT_MAX_EVENTS_PER_FILE). Empty uses the API default of 100000."
            }
          }
        }
      }
    },
    "workflowConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "not": {
        "allOf": [
          {"anyOf": [{"required": ["includeDefaults"]}, {"required": ["configMaps"]}]},
          {"anyOf": [{"required": ["existingConfigMap"]}, {"required": ["items"]}, {"required": ["extraConfigMaps"]}]}
        ]
      },
      "properties": {
        "enabled": {"type": "boolean"},
        "includeDefaults": {
          "type": "boolean",
          "description": "Include bundled files not explicitly replaced by configMaps items; true when omitted."
        },
        "configMaps": {
          "type": "array",
          "items": {"$ref": "#/definitions/configMapSource"},
          "description": "Add files or explicitly replace a bundled file using replace: true on an item."
        },
        "extraConfigMaps": {
          "type": "array",
          "description": "Legacy additive sources; use configMaps for new deployments.",
          "items": {"$ref": "#/definitions/configMapSource"}
        },
        "existingConfigMap": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "items": {"$ref": "#/definitions/configMapItem"}
        }
      }
    }
  },
  "definitions": {
    "configMapSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "items"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/configMapItem"}
        }
      }
    },
    "configMapItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^(workflow-contracts|catalogs)/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(yaml|json)$"},
        "replace": {
          "type": "boolean",
          "description": "Replace this whole bundled file, not individual fields/entries. Requires configMaps and includeDefaults: true; the path must identify a bundled file."
        }
      }
    }
  }
}
