{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "classificationCatalogExistingConfigMap": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "classificationCatalog": {
      "not": {},
      "description": "Removed in 0.155.0. Store the complete catalog in a ConfigMap and use workflowConfiguration.configMaps with replace: true at catalogs/classifications.json."
    },
    "workflowConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "not": {
        "allOf": [
          {"anyOf": [{"required": ["includeDefaults"]}, {"required": ["configMaps"]}]},
          {"anyOf": [{"required": ["existingConfigMap"]}, {"required": ["items"]}, {"required": ["extraConfigMaps"]}]}
        ]
      },
      "properties": {
        "enabled": {"type": "boolean"},
        "includeDefaults": {
          "type": "boolean",
          "description": "Include bundled files not explicitly replaced by configMaps items; true when omitted."
        },
        "configMaps": {
          "type": "array",
          "items": {"$ref": "#/definitions/configMapSource"},
          "description": "Add files or explicitly replace a bundled file using replace: true on an item."
        },
        "extraConfigMaps": {
          "type": "array",
          "description": "Legacy additive sources; use configMaps for new deployments.",
          "items": {"$ref": "#/definitions/configMapSource"}
        },
        "existingConfigMap": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "items": {"$ref": "#/definitions/configMapItem"}
        }
      }
    }
  },
  "definitions": {
    "configMapSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "items"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/configMapItem"}
        }
      }
    },
    "configMapItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^(workflow-contracts|catalogs)/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(yaml|json)$"},
        "replace": {
          "type": "boolean",
          "description": "Replace this whole bundled file, not individual fields/entries. Requires configMaps and includeDefaults: true; the path must identify a bundled file."
        }
      }
    }
  }
}
