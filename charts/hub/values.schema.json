{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "classificationCatalog": {"type": ["array", "null"]},
    "workflowConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingConfigMap", "items"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingConfigMap": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "path"],
            "properties": {
              "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
              "path": {"type": "string", "pattern": "^(workflow-contracts|catalogs)/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(yaml|json)$"}
            }
          }
        }
      }
    }
  }
}
