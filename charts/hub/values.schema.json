{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "classificationCatalogExistingConfigMap": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "classificationCatalog": {"type": ["array", "null"]},
    "workflowConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "not": {
        "allOf": [
          {"anyOf": [{"required": ["includeDefaults"]}, {"required": ["configMaps"]}]},
          {"anyOf": [{"required": ["existingConfigMap"]}, {"required": ["items"]}, {"required": ["extraConfigMaps"]}]}
        ]
      },
      "properties": {
        "enabled": {"type": "boolean"},
        "includeDefaults": {
          "type": "boolean",
          "description": "Include bundled Start metadata and the effective classification catalog; true when omitted."
        },
        "configMaps": {
          "type": "array",
          "items": {"$ref": "#/definitions/configMapSource"}
        },
        "extraConfigMaps": {
          "type": "array",
          "description": "Legacy additive sources; use configMaps for new deployments.",
          "items": {"$ref": "#/definitions/configMapSource"}
        },
        "existingConfigMap": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "items": {"$ref": "#/definitions/configMapItem"}
        }
      }
    }
  },
  "definitions": {
    "configMapSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "items"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/configMapItem"}
        }
      }
    },
    "configMapItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "path"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "pattern": "^(workflow-contracts|catalogs)/[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(yaml|json)$"}
      }
    }
  }
}
